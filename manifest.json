{
  "manifest_version": 3,
  "name": "Goosle",
  "short_name": "Goosle",
  "version": "0.1.0",
  "description": "Calm social media: no Shorts or Reels, no ads, no algorithm feeds, no AI slop. Only what you chose to learn this week.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "src/popup/popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js", "scripts": ["src/background.js"] },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["src/shared/defaults.js", "src/shared/filter.js", "src/content/common.js", "src/content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.instagram.com/*"],
      "js": ["src/shared/defaults.js", "src/shared/filter.js", "src/content/common.js", "src/content/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.facebook.com/*", "*://web.facebook.com/*", "*://m.facebook.com/*"],
      "js": ["src/shared/defaults.js", "src/shared/filter.js", "src/content/common.js", "src/content/facebook.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.tiktok.com/*"],
      "js": ["src/shared/defaults.js", "src/shared/filter.js", "src/content/common.js", "src/content/tiktok.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "goosle@example.invalid", "strict_min_version": "121.0" } }
}
