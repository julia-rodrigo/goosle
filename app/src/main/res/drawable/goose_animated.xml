<?xml version="1.0" encoding="utf-8"?>
<!-- A goose, then dragon horns grow from its head, then it blinks.
     Used for the launch screen (Android 12+) and the app header. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <!-- Goosle: a goose silhouette with dragon horns. Drawn in a 100-unit box, centred in the 108 icon. -->
            <group android:name="root" android:pivotX="49" android:pivotY="47"
                android:scaleX="0.64" android:scaleY="0.64" android:translateX="5" android:translateY="6.5">
                <path android:name="goose" android:fillColor="#111111"
                    android:pathData="M90,22 C86,19.5 82,17.8 78,17 C76,13.5 72,12 68.5,13 C65.5,14 64,17 64.5,21 C65,27 66,33 64.5,40 C63.5,45 62,49 59,52 C52,51 44,47.5 35,47.5 C26,47.5 19,52 14,57 C11,59 8.5,59.5 6,59.5 C9,63 14,68 21,72 C27,79 38,84 50,84.5 C62,85 73,80 77.5,72 C80.5,66 79.5,59 75.5,53 C72.5,48.5 71,43 71.5,37 C72,32 73,28 75,26 C77,25 80,25 83,24.8 C86,24.6 88.5,23.5 90,22 Z" />
                <path android:name="legs" android:fillColor="#111111"
                    android:pathData="M50,84 L52.5,84 L53,93 L58.5,95 L50.6,95 Z M57,83.5 L59.5,83.5 L60.5,92.5 L66,94.5 L58,94.5 Z" />
                <group android:name="horns" android:pivotX="66" android:pivotY="17">
                    <path android:fillColor="#111111"
                        android:pathData="M71,13.5 C69,8 64,4.5 57,3 C53.5,2.3 50,1 47.5,-1.5 C49,3 52.5,6.5 57,8 C61,9.5 64,12 66,15.5 Z M67,15.6 C63,12.5 58,11.5 52,12 C48.5,12.3 45,11.5 42,9.5 C44.5,13.5 48.5,15.8 53,16.2 C57.5,16.6 61.5,18 64.6,20 Z" />
                </group>
                <group android:name="eye" android:pivotX="71.3" android:pivotY="17.6">
                    <path android:fillColor="#FFFFFF" android:pathData="M70,17.6 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="horns">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="150" android:duration="450" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="150" android:duration="450" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="eye">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1" android:duration="680" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="0.1" android:duration="80" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.1" android:valueTo="1" android:duration="120" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
